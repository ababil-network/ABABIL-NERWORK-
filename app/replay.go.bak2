package app

import (
	"errors"
	"sync"
)

type ReplayManager struct {
	mu   sync.RWMutex
	seen map[string]bool
}

var NodeReplay = &ReplayManager{
	seen: make(map[string]bool),
}

// Check returns true if the transaction hash has not been seen.
func (r *ReplayManager) Check(hash string) bool {
	if hash == "" {
		return false
	}

	r.mu.RLock()
	defer r.mu.RUnlock()

	return !r.seen[hash]
}

// Add marks a transaction hash as processed.
func (r *ReplayManager) Add(hash string) {
	if hash == "" {
		return
	}

	r.mu.Lock()
	defer r.mu.Unlock()

	r.seen[hash] = true
}

// TryAdd atomically checks and records a transaction hash.
func (r *ReplayManager) TryAdd(hash string) error {
	if hash == "" {
		return errors.New("empty transaction hash")
	}

	r.mu.Lock()
	defer r.mu.Unlock()

	if r.seen[hash] {
		return errors.New("replay transaction detected")
	}

	r.seen[hash] = true
	return nil
}

func (r *ReplayManager) Remove(hash string) {
	r.mu.Lock()
	defer r.mu.Unlock()

	delete(r.seen, hash)
}

func (r *ReplayManager) Exists(hash string) bool {
	r.mu.RLock()
	defer r.mu.RUnlock()

	return r.seen[hash]
}
