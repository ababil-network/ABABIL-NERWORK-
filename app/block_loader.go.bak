package app

import (
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
)

func LoadBlock(height int) (Block, error) {
	home, err := os.UserHomeDir()
	if err != nil {
		return Block{}, err
	}

	file := filepath.Join(
		home,
		".ababil",
		"data",
		"blocks",
		fmt.Sprintf("%d.json", height),
	)

	data, err := os.ReadFile(file)
	if err != nil {
		return Block{}, err
	}

	var block Block

	err = json.Unmarshal(data, &block)
	if err != nil {
		return Block{}, err
	}

	return block, nil
}
