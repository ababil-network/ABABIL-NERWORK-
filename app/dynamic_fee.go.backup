package app

import (
	"errors"
	"math"
	"sync"
)

const (
	// Final ABABIL fee architecture.
	//
	// 0-50%:
	//   50,000 transactions per $1.
	//
	// 50-85%:
	//   smoothly increases from 50,000 toward 20,000 TX/$.
	//
	// 85-95%:
	//   additional congestion surcharge.
	//
	// 95-100%:
	//   aggressive anti-spam congestion pricing.

	FeeLoadStartPercent         uint64 = 50
	FeeLoadDynamicEndPercent    uint64 = 85
	FeeLoadCongestionEndPercent uint64 = 95
	FeeLoadMaxPercent           uint64 = 100

	FeeTargetTXPerUSDLowLoad    uint64 = 50000
	FeeTargetTXPerUSDDynamicEnd uint64 = 20000

	// Effective target at 95% load before entering
	// the strongest anti-spam region.
	FeeTargetTXPerUSDCongestionEnd uint64 = 10000

	// Effective target at 100% load.
	// This represents aggressive congestion pricing.
	FeeTargetTXPerUSDMaxLoad uint64 = 2000
)

var (
	ErrInvalidLoad            = errors.New("invalid network load")
	ErrInvalidReferencePrice  = errors.New("invalid ABABIL reference price")
	ErrFeeCalculationOverflow = errors.New("fee calculation overflow")
)

type DynamicFeeManager struct {
	mu sync.RWMutex

	// Retained for mempool integration.
	// It is not itself the fee tier.
	PendingTx uint64

	LoadPercent uint64
}

var NodeDynamicFee = &DynamicFeeManager{}

func (d *DynamicFeeManager) SetPending(count uint64) {
	d.mu.Lock()
	defer d.mu.Unlock()

	d.PendingTx = count
}

func (d *DynamicFeeManager) SetLoadPercent(load uint64) error {
	if load > FeeLoadMaxPercent {
		return ErrInvalidLoad
	}

	d.mu.Lock()
	defer d.mu.Unlock()

	d.LoadPercent = load

	return nil
}

func (d *DynamicFeeManager) Load() uint64 {
	d.mu.RLock()
	defer d.mu.RUnlock()

	return d.LoadPercent
}

// TargetTransactionsPerUSD returns the deterministic fee target.
//
// The target is expressed as transactions per $1 equivalent.
//
// Lower TX/$ means a higher transaction fee.
func (d *DynamicFeeManager) TargetTransactionsPerUSD() uint64 {
	load := d.Load()

	switch {
	case load <= FeeLoadStartPercent:
		return FeeTargetTXPerUSDLowLoad

	case load <= FeeLoadDynamicEndPercent:
		return interpolateDescending(
			FeeTargetTXPerUSDLowLoad,
			FeeTargetTXPerUSDDynamicEnd,
			load-FeeLoadStartPercent,
			FeeLoadDynamicEndPercent-FeeLoadStartPercent,
		)

	case load <= FeeLoadCongestionEndPercent:
		return interpolateDescending(
			FeeTargetTXPerUSDDynamicEnd,
			FeeTargetTXPerUSDCongestionEnd,
			load-FeeLoadDynamicEndPercent,
			FeeLoadCongestionEndPercent-FeeLoadDynamicEndPercent,
		)

	default:
		return interpolateDescending(
			FeeTargetTXPerUSDCongestionEnd,
			FeeTargetTXPerUSDMaxLoad,
			load-FeeLoadCongestionEndPercent,
			FeeLoadMaxPercent-FeeLoadCongestionEndPercent,
		)
	}
}

// CalculateUSDPerTransaction returns the USD-equivalent fee
// for one transaction.
//
// 1 USD = 1,000,000 micro-USD.
func (d *DynamicFeeManager) CalculateUSDPerTransaction() (uint64, uint64, error) {
	target := d.TargetTransactionsPerUSD()

	if target == 0 {
		return 0, 0, ErrInvalidLoad
	}

	const microUSDPerUSD uint64 = 1_000_000

	feeMicroUSD := microUSDPerUSD / target

	if feeMicroUSD == 0 {
		feeMicroUSD = 1
	}

	return feeMicroUSD, target, nil
}

// CalculateNativeFee converts the USD-equivalent fee into
// the smallest native ABABIL unit.
//
// referencePriceMicroUSD:
// price of 1 ABABIL expressed in micro-USD.
//
// Example:
// 1 ABABIL = $0.10
// referencePriceMicroUSD = 100,000.
func (d *DynamicFeeManager) CalculateNativeFee(
	referencePriceMicroUSD uint64,
) (uint64, error) {
	if referencePriceMicroUSD == 0 {
		return 0, ErrInvalidReferencePrice
	}

	feeMicroUSD, _, err := d.CalculateUSDPerTransaction()
	if err != nil {
		return 0, err
	}

	const scale uint64 = 1_000_000

	if feeMicroUSD > math.MaxUint64/scale {
		return 0, ErrFeeCalculationOverflow
	}

	numerator := feeMicroUSD * scale

	feeMicroABABIL := numerator / referencePriceMicroUSD

	if feeMicroABABIL == 0 {
		feeMicroABABIL = 1
	}

	return feeMicroABABIL, nil
}

func interpolateDescending(
	start uint64,
	end uint64,
	position uint64,
	rangeSize uint64,
) uint64 {
	if rangeSize == 0 {
		return end
	}

	if position >= rangeSize {
		return end
	}

	delta := start - end

	// Prevent multiplication overflow.
	if delta != 0 && position > math.MaxUint64/delta {
		return end
	}

	return start - (delta*position)/rangeSize
}
