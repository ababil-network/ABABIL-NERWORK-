package app

const (
	ProtocolVersion uint16 = 1

	NetworkID = "ababil-mainnet"

	ChainID = uint64(7777)

	MaxMessageSize uint32 = 16 * 1024 * 1024 // 16 MB
)

type MessageType uint16

const (
	MsgHandshake MessageType = 1

	MsgTransaction MessageType = 2

	MsgBlock MessageType = 3

	MsgPing MessageType = 4

	MsgPong MessageType = 5

	MsgPeerList MessageType = 6
)

type MessageHeader struct {
	Version uint16

	Type MessageType

	ChainID uint64

	Length uint32
}
